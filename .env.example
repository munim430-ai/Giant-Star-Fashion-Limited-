# Optional — RFQ email delivery via Resend (https://resend.com).
# Without these the RFQ form still validates submissions and hands the buyer a
# pre-filled email to info@giantstarbd.com instead.
RESEND_API_KEY=
# Inbox that receives RFQs (comma-separate multiple addresses).
RFQ_TO_EMAIL=info@giantstarbd.com
# Sender on a domain verified in Resend, e.g. "GSFL Website <rfq@giantstarbd.com>".
RFQ_FROM_EMAIL=

# Canonical site URL used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://giantstarbd.com
